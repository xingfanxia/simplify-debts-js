{
  "$schema": "https://static.cloudbase.net/cli/cloudbaserc.schema.json",
  "version": "2.0",
  "envId": "cloud1-d3gbdocpk8fcb2e97",
  "region": "ap-shanghai",
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "ledger",
      "type": "Event",
      "runtime": "Nodejs16.13",
      "handler": "index.main",
      "timeout": 20,
      "memorySize": 256,
      "installDependency": true
    },
    {
      "name": "ledger_cleanup",
      "type": "Event",
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "timeout": 300,
      "memorySize": 256,
      "installDependency": true,
      "triggers": [
        {
          "name": "dailyLedgerRetention",
          "type": "timer",
          "config": "0 20 3 * * * *"
        }
      ]
    }
  ]
}
