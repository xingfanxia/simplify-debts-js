.history-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 0;
  box-sizing: border-box;
  color: var(--ink);
  background: var(--bg);
}
.page-intro { padding: 4rpx 4rpx 22rpx; }
.page-title, .page-subtitle { display: block; }
.page-title { font-size: 40rpx; font-weight: 750; line-height: 1.2; }
.page-subtitle { margin-top: 8rpx; color: var(--muted); font-size: 27rpx; line-height: 1.5; }
.history-tabs { display: flex; margin: 4rpx 0 20rpx; padding: 6rpx; gap: 6rpx; background: var(--surface-2); border: 2rpx solid var(--line-soft); border-radius: 16rpx; }
.history-tab { display: flex; flex: 1 1 0; width: 0 !important; min-width: 0; height: 76rpx; margin: 0 !important; padding: 0 22rpx; align-items: center; justify-content: center; gap: 10rpx; color: var(--muted); font-size: 27rpx; font-weight: 700; line-height: 76rpx; background: transparent; border: 0; border-radius: 12rpx; }
.history-tab::after { border: 0; }
.history-tab > text:last-child { min-width: 34rpx; height: 34rpx; padding: 0 8rpx; box-sizing: border-box; color: var(--muted); font-size: 21rpx; font-weight: 750; line-height: 34rpx; background: var(--surface); border-radius: 17rpx; }
.history-tab.active { color: var(--primary-ink); background: var(--primary); }
.history-tab.active > text:last-child { color: var(--primary-ink); background: rgba(255, 255, 255, .62); }
.sync-note { display: flex; min-height: 54rpx; margin: -4rpx 2rpx 14rpx; align-items: center; gap: 12rpx; color: var(--muted); font-size: 24rpx; }
.sync-note.error { color: var(--danger); }
.sync-dot { width: 12rpx; height: 12rpx; background: var(--primary); border-radius: 50%; }
.history-list { display: flex; flex-direction: column; gap: 16rpx; }
.history-entry { padding: 24rpx; background: var(--surface); border: 2rpx solid var(--line); border-radius: 20rpx; }
.entry-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16rpx; }
.entry-heading { flex: 1; min-width: 0; }
.entry-date { color: var(--muted); font-size: 25rpx; font-weight: 600; }
.entry-title { display: block; margin-top: 8rpx; overflow: hidden; font-size: 30rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.entry-meta { display: flex; align-items: flex-end; justify-content: space-between; margin-top: 18rpx; padding: 16rpx 0; border-top: 2rpx solid var(--line-soft); border-bottom: 2rpx solid var(--line-soft); }
.entry-meta text { display: block; }
.entry-meta text:first-child { font-size: 30rpx; font-weight: 750; }
.entry-meta text:last-child { margin-top: 4rpx; color: var(--muted); font-size: 25rpx; }
.entry-avatars { display: flex; flex-direction: row-reverse; padding-left: 18rpx; }
.entry-avatars view { display: flex; align-items: center; justify-content: center; width: 50rpx; height: 50rpx; margin-left: -8rpx; font-size: 28rpx; line-height: 1; border: 3rpx solid var(--surface); border-radius: 50%; }
.avatar-coral { background: var(--coral); }
.avatar-mint { background: var(--mint); }
.avatar-blue { background: var(--blue); }
.avatar-purple { background: var(--purple); }
.avatar-accent { background: var(--accent); }
.delete-button { flex: 0 0 112rpx; width: 112rpx !important; min-width: 112rpx; height: 68rpx; margin: 0 !important; padding: 0; color: var(--danger); font-size: 25rpx; font-weight: 650; line-height: 68rpx; background: transparent; border: 2rpx solid var(--line); border-radius: 12rpx; }
.entry-actions { width: 100%; margin-top: 16rpx; }
.open-button { display: flex; width: 100% !important; min-width: 0; height: 86rpx; margin: 0 !important; padding: 0 22rpx; align-items: center; justify-content: space-between; color: var(--primary-ink); font-size: 28rpx; font-weight: 700; line-height: 86rpx; background: var(--primary); border-radius: 14rpx; }
.shared-entry .entry-date { color: var(--primary); }
.history-empty { display: flex; flex-direction: column; align-items: center; padding: 96rpx 30rpx; text-align: center; }
.empty-icon { width: 82rpx; height: 82rpx; padding: 22rpx 18rpx; box-sizing: border-box; background: var(--accent); border-radius: 50%; }
.empty-icon view { height: 4rpx; margin-bottom: 8rpx; background: var(--accent-ink); border-radius: 3rpx; }
.empty-icon.shared { display: flex; padding: 22rpx 16rpx; align-items: center; justify-content: center; gap: 4rpx; }
.empty-icon.shared view { width: 26rpx; height: 26rpx; margin: 0 -3rpx 0 0; background: transparent; border: 4rpx solid var(--accent-ink); border-radius: 50%; }
.history-empty > text:nth-child(2) { margin-top: 22rpx; font-size: 29rpx; font-weight: 750; }
.history-empty > text:last-child { max-width: 520rpx; margin-top: 8rpx; color: var(--muted); font-size: 27rpx; line-height: 1.5; }
