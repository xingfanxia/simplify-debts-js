.settings-page {
  min-height: 100vh;
  padding: 28rpx 24rpx 0;
  box-sizing: border-box;
  color: var(--ink);
  background: var(--bg);
}
.page-intro { padding: 4rpx 4rpx 22rpx; }
.page-title, .page-subtitle, .setting-row text, .privacy-card text { display: block; }
.page-title { font-size: 40rpx; font-weight: 750; line-height: 1.2; }
.page-subtitle { margin-top: 9rpx; color: var(--muted); font-size: 25rpx; line-height: 1.45; }
.settings-card, .privacy-card { margin-top: 16rpx; background: var(--surface); border: 2rpx solid var(--line); border-radius: 20rpx; }
.settings-card { overflow: hidden; }
.setting-row { display: flex; align-items: center; justify-content: space-between; min-height: 96rpx; padding: 17rpx 22rpx; border-bottom: 2rpx solid var(--line-soft); }
.settings-card picker:last-child .setting-row { border-bottom: 0; }
.setting-row > view { flex: 1; min-width: 0; }
.setting-row view text:first-child { font-size: 27rpx; font-weight: 700; }
.setting-row view text:last-child { margin-top: 5rpx; overflow: hidden; color: var(--muted); font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.chevron { margin-left: 18rpx; color: var(--muted); font-size: 38rpx; font-weight: 300; }
.privacy-card { display: flex; align-items: flex-start; padding: 22rpx; }
.privacy-card view:last-child { flex: 1; }
.privacy-card text:first-child { font-size: 26rpx; font-weight: 700; }
.privacy-card text:last-child { margin-top: 6rpx; color: var(--muted); font-size: 24rpx; line-height: 1.5; }
