<view class="room-page {{themeClass}}">
  <view class="state-page" wx:if="{{mode === 'loading'}}">
    <view class="spinner"></view>
    <text>正在打开共享账单…</text>
  </view>

  <view class="state-page" wx:elif="{{mode === 'error'}}">
    <view class="state-icon">!</view>
    <text class="state-title">无法打开</text>
    <text class="state-help">{{errorMessage}}</text>
    <button class="secondary-button" bindtap="onPullDownRefresh">重新尝试</button>
  </view>

  <view class="join-page" wx:elif="{{mode === 'preview'}}">
    <view class="join-heading">
      <text class="overline">共享账单邀请</text>
      <text class="join-title">{{preview.title}}</text>
      <text class="join-meta">{{preview.currency}} · {{preview.memberCount}} 位成员</text>
    </view>

    <view class="join-card">
      <text class="card-title">加入共享账单</text>
      <text class="card-help">确认一个群里好认的昵称。加入后系统会自动分配 Emoji 标记，你可以随时更换。</text>
      <label class="field-label">你的昵称</label>
      <input class="field-input" type="nickname" value="{{joinNickname}}" maxlength="28" placeholder="在账单中显示的名字" bindinput="onJoinNicknameInput" />
      <button class="primary-button" loading="{{joining}}" disabled="{{joining}}" bindtap="joinRoom">确认加入 <text>→</text></button>
    </view>
    <text class="privacy-note">微信账号仅用于确认成员身份，不会显示给其他人。</text>
  </view>

  <block wx:elif="{{mode === 'room'}}">
    <view class="room-header">
      <view class="room-heading-row">
        <view class="room-heading-copy"><text class="overline">共享账单</text><text class="room-title">{{roomTitle}}</text></view>
        <view class="sync-pill {{syncClass}}"><view></view><text>{{syncText}}</text></view>
      </view>
      <view class="room-meta"><picker range="{{currencyValues}}" value="{{currencyIndex}}" disabled="{{!canManage || readOnly}}" bindchange="onRoomCurrencyChange"><view>{{currency}}{{canManage && !readOnly ? '⌄' : ''}}</view></picker><text>{{revisionText}}</text><text>{{membersView.length}} 位成员</text></view>
      <view class="invite-actions" wx:if="{{canManage && !readOnly}}">
        <button class="invite-button" wx:if="{{!inviteReady}}" loading="{{invitePreparing}}" disabled="{{invitePreparing}}" bindtap="prepareInvite">生成微信邀请 <text>↗</text></button>
        <block wx:else>
          <button class="invite-button" open-type="share">发送邀请 <text>↗</text></button>
          <view class="invite-ready-row"><text>{{inviteExpiryText}}</text><button bindtap="revokeCurrentInvite">撤销</button></view>
        </block>
      </view>
    </view>

    <view class="room-content">
      <view class="summary-card">
        <view><text>总支出</text><text>{{totalSpendText}}</text></view>
        <view><text>支出</text><text>{{expensesView.length}}</text></view>
        <view><text>还款</text><text>{{transfersView.length}}</text></view>
      </view>

      <view class="tool-card" id="shared-expense-composer">
        <view class="card-heading"><view><text class="card-title">{{editingExpenseId ? '编辑支出' : '添加支出'}}</text><text class="card-help">保存后会同步给房间里的所有成员。</text></view><button wx:if="{{editingExpenseId}}" bindtap="cancelExpenseEdit">取消</button></view>
        <view class="readonly-banner" wx:if="{{readOnly}}">{{syncClass === 'offline' ? '离线状态下只能查看最近同步的内容。' : '该账单已归档，只能查看。'}}</view>
        <block wx:else>
          <label class="field-label">支出内容</label>
          <input class="field-input" value="{{expenseForm.description}}" maxlength="60" placeholder="晚餐、车票、民宿…" bindinput="onDescriptionInput" />
          <view class="two-fields">
            <view><label class="field-label">金额（{{currency}}）</label><input class="field-input" type="digit" value="{{expenseForm.amount}}" placeholder="{{amountPlaceholder}}" bindinput="onAmountInput" /></view>
            <view><label class="field-label">付款人</label><picker range="{{participantNames}}" value="{{payerIndex}}" bindchange="onPayerChange"><view class="picker-field">{{participantNames[payerIndex] || '请选择'}} <text>⌄</text></view></picker></view>
          </view>
          <label class="field-label">由谁分摊</label>
          <view class="split-mode-control">
            <button class="split-mode-option {{expenseForm.splitMode === 'everyone' ? 'is-active' : ''}}" bindtap="chooseEveryone" aria-label="全员均摊"><text class="split-mode-mark">{{expenseForm.splitMode === 'everyone' ? '✓' : ''}}</text><view class="split-mode-copy"><text>全员均摊</text><text>{{participantsView.length}} 人参与</text></view></button>
            <button class="split-mode-option {{expenseForm.splitMode === 'custom' ? 'is-active' : ''}}" bindtap="chooseCustom" aria-label="指定成员分摊"><text class="split-mode-mark">{{expenseForm.splitMode === 'custom' ? '✓' : ''}}</text><view class="split-mode-copy"><text>指定成员</text><text wx:if="{{expenseForm.splitMode === 'custom'}}">{{expenseForm.selectedIds.length}} 人已选</text><text wx:else>按需选择</text></view></button>
          </view>
          <view class="split-grid" wx:if="{{expenseForm.splitMode === 'custom'}}">
            <text class="split-grid-help">点选参与这笔支出的人</text>
            <button class="split-option {{item.selected ? 'is-selected' : ''}}" wx:for="{{participantsView}}" wx:key="participantId" data-id="{{item.participantId}}" bindtap="toggleSplitPerson"><view><view class="avatar avatar-small {{item.avatarClass}}">{{item.avatarEmoji}}</view><text>{{item.name}}</text></view><text>{{item.selected ? '✓' : '+'}}</text></button>
          </view>
          <text class="form-error" wx:if="{{formError}}">{{formError}}</text>
          <button class="primary-button" loading="{{mutating}}" disabled="{{mutating}}" bindtap="submitExpense">{{editingExpenseId ? '保存修改' : '添加支出'}} <text>→</text></button>
        </block>
      </view>

      <view class="tool-card" wx:if="{{expensesView.length}}">
        <view class="card-heading"><view><text class="card-title">支出记录</text><text class="card-help">最近同步的 {{expensesView.length}} 笔支出。</text></view></view>
        <view class="expense-list">
          <view class="expense-row {{item.isEditing ? 'is-editing' : ''}}" wx:for="{{expensesView}}" wx:key="expenseId">
            <view class="expense-main"><text>{{item.description}}</text><text>{{item.payerName}} 付款 · {{item.splitText}}</text></view>
            <text class="expense-money">{{item.amountText}}</text>
            <view class="expense-actions" wx:if="{{!readOnly}}"><button data-id="{{item.expenseId}}" bindtap="editExpense">编辑</button><button class="danger-text" data-id="{{item.expenseId}}" bindtap="removeExpense">删除</button></view>
          </view>
        </view>
      </view>

      <view class="tool-card settlement-card">
        <view class="card-heading"><view><text class="card-title">结算方案</text><text class="card-help">根据当前支出自动计算。</text></view><text>{{currency}}</text></view>
        <view class="settlement-empty" wx:if="{{!expensesView.length}}">添加支出后，这里会显示还款路径。</view>
        <view class="settlement-empty" wx:elif="{{!transfersView.length}}">✓ 当前已经结清</view>
        <view class="transfer-list" wx:else>
          <view class="transfer-row" wx:for="{{transfersView}}" wx:key="key"><view class="transfer-person"><view class="avatar avatar-small {{item.fromClass}}">{{item.fromAvatarEmoji}}</view><text class="transfer-name">{{item.fromName}}</text></view><view class="transfer-direction"><text class="transfer-money">{{item.amountText}}</text><text class="arrow">→</text></view><view class="transfer-person transfer-person-right"><view class="avatar avatar-small {{item.toClass}}">{{item.toAvatarEmoji}}</view><text class="transfer-name transfer-name-right">{{item.toName}}</text></view></view>
        </view>
        <view class="room-share-actions" wx:if="{{transfersView.length}}">
          <button class="room-share-button room-share-image" bindtap="shareSettlementImage"><text>▧</text><text>分享结算图</text></button>
          <button class="room-share-button" bindtap="copySettlementText"><text>T</text><text>复制文字</text></button>
        </view>
        <view class="rounding-row"><view><text>整数还款</text><text>取整的同时保持总额平衡。</text></view><switch checked="{{snapshot.room.roundToWhole}}" disabled="{{readOnly}}" color="#24724d" bindchange="toggleRounding" /></view>
      </view>

      <view class="tool-card members-card">
        <view class="card-heading"><view><text class="card-title">成员</text><text class="card-help">加入的成员都可以共同记账。</text></view><text>{{membersView.length}}</text></view>
        <view class="member-row" wx:for="{{membersView}}" wx:key="memberId">
          <view class="avatar {{item.avatarClass}}">{{item.avatarEmoji}}</view>
          <view><text>{{item.displayName}}{{item.isSelf ? '（你）' : ''}}</text><text>{{item.roleText}}</text></view>
          <button wx:if="{{item.canEditProfile}}" bindtap="openProfileDialog">编辑资料</button>
          <button wx:elif="{{item.canRemove && !readOnly}}" class="danger-text" data-id="{{item.memberId}}" bindtap="removeMember">移除</button>
        </view>
      </view>

      <view class="tool-card" wx:if="{{canManage && inviteListView.length}}">
        <view class="card-heading"><view><text class="card-title">邀请记录</text><text class="card-help">邀请链接不会显示在这里，可以随时撤销访问能力。</text></view></view>
        <view class="invite-record" wx:for="{{inviteListView}}" wx:key="inviteId"><view><text>{{item.statusText}} · {{item.expiryText}}</text><text>{{item.usageText}}</text></view><button wx:if="{{item.active && !readOnly}}" data-id="{{item.inviteId}}" bindtap="revokeInvite">撤销</button></view>
      </view>

      <view class="room-controls" wx:if="{{syncClass !== 'offline'}}">
        <button wx:if="{{!canManage}}" bindtap="leaveRoom">退出共享账单</button>
        <block wx:else>
          <button wx:if="{{snapshot.room.status === 'active'}}" bindtap="archiveRoom">归档账单</button>
          <button class="danger-text" bindtap="deleteRoom">删除共享账单</button>
        </block>
      </view>
      <text class="privacy-footer">云端仅当前成员可访问；本机保留最近同步的只读副本。</text>
    </view>
  </block>

  <view class="dialog-backdrop" wx:if="{{showProfileDialog}}" bindtap="closeProfileDialog">
    <view class="profile-dialog" catchtap="noop">
      <text class="card-title">编辑我的资料</text>
      <text class="card-help">昵称和 Emoji 只用于这个账单，并会同步给其他成员。</text>
      <input class="field-input profile-input" type="nickname" value="{{profileNicknameInput}}" maxlength="28" placeholder="在账单中显示的名字" bindinput="onProfileNicknameInput" />
      <button class="profile-avatar-row" bindtap="toggleProfileAvatarPicker"><view class="avatar avatar-large avatar-accent">{{profileAvatarEmoji}}</view><view><text>Emoji 标记</text><text>{{profileAvatarMode === 'auto' ? '自动分配' : '已选择'}}</text></view><text>{{profileChoosingAvatar ? '收起' : '更换'}}</text></button>
      <view class="profile-avatar-picker" wx:if="{{profileChoosingAvatar}}">
        <scroll-view class="profile-avatar-scroll" scroll-y><view class="profile-avatar-grid"><button class="profile-avatar-option {{item === profileAvatarEmoji ? 'is-selected' : ''}}" wx:for="{{avatarOptions}}" wx:key="*this" data-emoji="{{item}}" bindtap="chooseProfileAvatar"><text>{{item}}</text></button></view></scroll-view>
        <view class="profile-avatar-actions"><button bindtap="randomizeProfileAvatar">随机一个</button><button bindtap="restoreProfileAvatar">恢复自动分配</button></view>
      </view>
      <view class="dialog-actions">
        <button disabled="{{updatingProfile}}" bindtap="closeProfileDialog">取消</button>
        <button class="dialog-primary" loading="{{updatingProfile}}" disabled="{{updatingProfile}}" bindtap="updateProfile">保存</button>
      </view>
    </view>
  </view>
  <canvas type="2d" id="shareCanvas" class="share-canvas" style="width: 720px; height: {{shareCanvasHeight}}px;"></canvas>
  <view class="safe-bottom"></view>
</view>
