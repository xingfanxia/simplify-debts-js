{
  "name": "settle-debt-simplifier",
  "private": true,
  "version": "2.0.3",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:mini:rooms": "vitest run tests/miniprogram-rooms.test.js",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:android:debug": "npm run mobile:sync && ./scripts/android-gradle.sh assembleDebug",
    "mobile:android:apk": "npm run mobile:sync && ./scripts/android-gradle.sh assembleRelease",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "mini:configure": "node scripts/configure-wechat-mini.mjs",
    "mini:open": "/Applications/wechatwebdevtools.app/Contents/MacOS/cli open --project \"$PWD\" --lang zh",
    "mini:preview": "/Applications/wechatwebdevtools.app/Contents/MacOS/cli preview --project \"$PWD\" --lang zh",
    "mini:cloud:list": "/Applications/wechatwebdevtools.app/Contents/MacOS/cli cloud env list --project \"$PWD\" --lang zh",
    "mini:cloud:deploy:health": "/Applications/wechatwebdevtools.app/Contents/MacOS/cli cloud functions deploy --env cloud1-d3gbdocpk8fcb2e97 --project \"$PWD\" --names health --remote-npm-install --lang zh",
    "mini:cloud:deploy:ledger": "/Applications/wechatwebdevtools.app/Contents/MacOS/cli cloud functions deploy --env cloud1-d3gbdocpk8fcb2e97 --project \"$PWD\" --names ledger --remote-npm-install --lang zh",
    "mini:cloud:deploy:cleanup": "/Applications/wechatwebdevtools.app/Contents/MacOS/cli cloud functions deploy --env cloud1-d3gbdocpk8fcb2e97 --project \"$PWD\" --names ledger_cleanup --remote-npm-install --lang zh",
    "mini:upload": "/Applications/wechatwebdevtools.app/Contents/MacOS/cli upload --project \"$PWD\" --lang zh"
  },
  "dependencies": {
    "@capacitor/clipboard": "^8.0.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
